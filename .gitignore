# Generated rankings and audit records. Commit deliberately, not by accident.
# The rankings directory itself is tracked via .gitkeep so the CLI always has
# somewhere to write.
data/outputs/*
!data/outputs/rankings/
data/outputs/rankings/*
!data/outputs/rankings/.gitkeep
